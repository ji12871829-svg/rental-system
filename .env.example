# ============================================================================
# Rental Property Management System — environment template
# Copy to backend/.env and fill in real values. NEVER commit .env files.
# ============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://rms_user:rms_password@localhost:5432/rpms

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# --- M-Pesa Daraja (optional; mock mode records no provider calls) ---
MPESA_PROVIDER=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/c2b/confirm
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_TIMEOUT_MS=15000

# --- SMS ---
# Pick one provider. Empty/absent = mock (simulated sends, no network, no cost).
#   mock             simulated — used automatically whenever NODE_ENV=test
#   africastalking   real delivery, BUT Safaricom rejects unregistered sender
#                    IDs, so a branded Sender ID costs a KES 8,700 one-off setup
#                    fee on top of ~KES 0.80 per SMS.
#   twilio           global alternative (trial account = 100 test SMS only)
#   textbee          FREE route — an Android phone with a local SIM relays the
#                    send. No Sender ID to buy or register: the SMS leaves as a
#                    normal text from that SIM, and the only cost is your
#                    carrier bundle (~1,000 SMS for KES 30/week). The phone must
#                    stay powered and on signal. textbee free tier: 50/day,
#                    300/month, 1 device.
SMS_PROVIDER=mock

# --- SMS: Africa's Talking (SMS_PROVIDER=africastalking) ---
SMS_API_KEY=
SMS_USERNAME=
# Optional registered sender ID (e.g. "RPMS"). Leave empty to fall back to the
# Africa's Talking default — note Safaricom may filter these.
SMS_SENDER_ID=
# Low-balance warning threshold in provider currency units (0 = disabled).
SMS_LOW_BALANCE_THRESHOLD=

# --- SMS: textbee own-SIM gateway (SMS_PROVIDER=textbee) ---
# 1. Install the textbee app on an Android phone with an active SIM and register
#    it at https://textbee.dev
# 2. Dashboard → API Keys → Generate API Key (shown once) → TEXTBEE_API_KEY.
TEXTBEE_API_KEY=
# Hosted default; set this only when self-hosting your own textbee instance.
TEXTBEE_API_URL=https://api.textbee.dev/api/v1
# Optional: pin which registered phone sends. Leave empty to use the default
# device (relevant only if you register more than one phone).
TEXTBEE_DEVICE_ID=

# --- SMS: Twilio (SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Verified number (E.164) …
TWILIO_FROM=
# … OR a Messaging Service SID (recommended — handles number pooling).
TWILIO_MESSAGING_SERVICE_SID=

# Auto-send receipt SMS right after a payment commits (false = queue only).
SMS_AUTO_SEND=true