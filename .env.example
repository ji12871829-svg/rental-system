# ============================================================================
# Rental Property Management System — environment template
# Copy to backend/.env and fill in real values. NEVER commit .env files.
# ============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://rms_user:rms_password@localhost:5432/rpms

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# --- M-Pesa Daraja (optional; mock mode records no provider calls) ---
MPESA_PROVIDER=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/c2b/confirm
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_TIMEOUT_MS=15000

# --- SMS (Africa's Talking — optional; empty = simulated sends) ---
SMS_ENABLED=false
SMS_API_KEY=
SMS_USERNAME=