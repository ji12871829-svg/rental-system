[TEMPLATE]
# RPMS backend configuration — copy to backend/.env and fill in real values.
# Never commit backend/.env (it is git-ignored) and never put secrets in code.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Hosted deploys (Render + Neon) ------------------------------------------
# On Render, set these in the dashboard (Environment tab) — backend/.env is
# NOT committed and is NOT read there (no repo file to read).
#
# NODE_ENV=production
# PORT          leave unset — Render injects it (the app reads it)
# CORS_ORIGIN   only needed for SPLIT deploys (frontend on a different domain).
#               When Express serves frontend/dist itself (this repo's default
#               shape), the app is same-origin and CORS never fires. For split:
#               CORS_ORIGIN=https://your-frontend.onrender.com
#
# Required on Render (no defaults exist in production):
# JWT_SECRET    a long random string — generate with:
#               node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# DATABASE_URL  the Neon pooled connection string (see DEPLOY.md), e.g.
#               postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# BUSINESS_*    identity appended to receipt SMS and legal pages (see below).

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://rms_user:rms_password@localhost:5432/rpms
# TEST_DATABASE_URL=postgres://rms_user:rms_password@localhost:5432/rpms_test

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12# --- SMS (spec §34/§41) ------------------------------------------------------
# Business identity appended to every tenant receipt SMS as a legal line:
#   <name>, Reg. No. <reg>. This receipt is proof of payment.
#
# Contact details appended under the identity (optional, plain text — phones
# auto-linkify them, and the SMS history page shows them as tel:/mailto: links).
# BUSINESS_NAME=Acme Properties Ltd
# BUSINESS_REG_NO=C.123456
# BUSINESS_PHONE=+254722000000
# BUSINESS_EMAIL=info@example.com

# Provider used when a receipt SMS is sent. Only ONE of these blocks is active
# at a time — the others are inert commented-out fields. Pick exactly one and
# comment out the rest:
#
#   mock             (default) simulated — sends are recorded in SMS history
#                    with a MOCK-<id> reference, nothing is delivered
#   africastalking   real delivery via Africa's Talking (Kenya). Note Safaricom
#                    rejects unregistered sender IDs, so a branded Sender ID
#                    costs a KES 8,700 one-off setup fee on top of ~KES 0.80/SMS.
#   twilio           real delivery via Twilio (global; trial = 100 test SMS)
#   textbee          FREE route — an Android phone with a local SIM relays the
#                    send. No Sender ID to buy or register: the SMS leaves as a
#                    normal text from that SIM, so the only cost is your carrier
#                    bundle (~1,000 SMS for KES 30/week, vs AT's KES 0.80/SMS).
#                    The phone must stay powered and on signal. Free tier:
#                    50/day, 300/month, 1 device.
SMS_PROVIDER=mock

# --- Shared SMS knobs (active for every live SMS provider) ----------------------
# Auto-send receipt SMS as soon as a payment is recorded (default true).
# Set false to keep messages PENDING for manual sending from SMS history.
SMS_AUTO_SEND=true
# Automatic retry of FAILED SMS with exponential backoff (1m → 5m → 25m by
# default). Retries stop after SMS_MAX_SEND_ATTEMPTS total attempts; the row
# stays FAILED (visibly "gave up") and can still be sent manually.
# SMS_RETRY_ENABLED=true
# SMS_MAX_SEND_ATTEMPTS=3
# SMS_RETRY_BASE_DELAY_MS=60000
# Low-balance warning threshold in provider currency units (0 = disabled).
# NOTE: textbee has no pre-paid wallet, so with SMS_PROVIDER=textbee this
# strip instead reports "no wallet — cost is your carrier bundle" and points
# you at the textbee dashboard's free-tier quota (50/day, 300/month).
SMS_LOW_BALANCE_THRESHOLD=100

# =============================================================================
# SMS block: mock (active when SMS_PROVIDER=mock) — nothing to fill in.
# =============================================================================

# =============================================================================
# SMS block: Africa's Talking (active when SMS_PROVIDER=africastalking)
# =============================================================================
# Real values go in SMS_API_KEY + SMS_USERNAME.
# SMS_USERNAME=your-at-username
# SMS_API_KEY=your-at-api-key
# Optional registered sender ID (e.g. your approved Alphanumeric Sender ID).
# Omit it to send from Africa's Talking's default numeric sender — note Safaricom
# may filter these.
# SMS_SENDER_ID=RPMS

# =============================================================================
# SMS block: textbee own-SIM gateway (active when SMS_PROVIDER=textbee)
# =============================================================================
# 1. Install the textbee app on an Android phone with an active local SIM and
#    register the device at https://textbee.dev (the phone must stay powered
#    and on signal, or sends queue and then fail).
# 2. Dashboard → API Keys → Generate API Key (displayed only once).
#
#   TEXTBEE_API_KEY=<real-textbee-api-key>
#
# Hosted default — set this only to point at your own self-hosted instance.
#   TEXTBEE_API_URL=https://api.textbee.dev/api/v1
#
# Optional: pin which registered phone sends. Leave empty to use the default
# device (only relevant if you register more than one phone).
#   TEXTBEE_DEVICE_ID=
#
# No SMS_SENDER_ID here by design: the SIM in the phone is the sender, and
# SMS_PROVIDER=textbee never accepts a sender identity from the backend.
#
# Shared knobs (these stay the same regardless of SMS_PROVIDER):
# SMS_AUTO_SEND=true
# SMS_LOW_BALANCE_THRESHOLD=100

# =============================================================================
# SMS block: Twilio (active when SMS_PROVIDER=twilio)
# =============================================================================
# Account SID + auth token from console.twilio.com, then either a Messaging
# Service SID (recommended: number pooling, alpha sender) or a verified From
# number in E.164 format.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+15550001111

# Notes:
# - NODE_ENV=test always forces the mock provider — tests never send real SMS.
# - If the active provider is missing credentials, sends are recorded as
#   FAILED with a clear reason; the API logs a warning at boot.
# - To switch providers, change SMS_PROVIDER and make sure only that block's
#   fields are uncommented. The shared knobs above stay the same.


# --- Email receipts -----------------------------------------------------------
# Email delivery of receipts. The receipt renders as the email body (HTML +
# plain-text alternative) with a standalone .html copy attached.
#   mock  (default) simulated — sends are recorded in email history with a
#         MOCK-<id> reference, nothing is delivered
#   smtp  real delivery via any SMTP server (Gmail app password, transactional
#         relay, your host's mail server...)
EMAIL_PROVIDER=mock
EMAIL_AUTO_SEND=true
# Brevo API test mode: use a verified sender and restrict delivery to test recipients.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TEST_RECIPIENTS=your-test-email@example.com

# SMTP connection — required only when EMAIL_PROVIDER=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        (true for port 465)
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password

# Verified sender address shown to tenants — MUST be an address you control.
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Olbano Property Management   (defaults to BUSINESS_NAME)
#
# Notes:
# - NODE_ENV=test always forces the mock provider — tests never send real email.
# - If EMAIL_PROVIDER=smtp but SMTP_HOST / SMTP_USER / SMTP_PASS / EMAIL_FROM
#   are missing, sends are recorded as FAILED with the reason.

# ---------------------------------------------------------------------------
# Clerk (optional) — hosted staff sign-in. When CLERK_SECRET_KEY is set the
# backend accepts Clerk sessions mapped to local users (user_external_ids) on
# every staff route, and the staff tab of /login renders Clerk's sign-in card
# when VITE_CLERK_PUBLISHABLE_KEY is present in the frontend build. Unset =
# the legacy password flow only, nothing else changes. Setup steps, user
# mapping and rollback: docs/runbooks/RUNBOOK-clerk-setup.md.
# CLERK_SECRET_KEY=sk_test_…

# --- JWT split secrets (recommended in production) ---------------------------
# The staff app and tenant portal each mint JWTs. With one shared JWT_SECRET
# the two auth domains are separated only by the audience claim; give each
# population its own key so a token from one side can never be replayed on
# the other. Unset values fall back to JWT_SECRET (unchanged behavior).
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_STAFF_SECRET=
# JWT_PORTAL_SECRET=

# --- Tenant portal ------------------------------------------------------------
# Absolute URL of the portal login page, used in credential-delivery emails —
# must be reachable from the tenant's device.
# PORTAL_URL=https://your-app.onrender.com/portal/login

# --- M-Pesa (Daraja) -----------------------------------------------------------
#   mock    (default) simulated STK pushes — nothing is sent to Safaricom
#   daraja  real STK Push + C2B callbacks via Safaricom Daraja
# MPESA_PROVIDER=mock
# Credentials from developer.safaricom.co.ke (required when MPESA_PROVIDER=daraja):
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=              your Paybill / shortcode receiving the money
# MPESA_PASSKEY=                Sandbox or production Lipa na M-Pesa passkey
# MPESA_CALLBACK_URL=           https://<host>/api/mpesa/stk/callback
# Base URL switches sandbox/production:
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# MPESA_TIMEOUT_MS=15000
# Shared secret guarding /api/mpesa/* callbacks (Daraja appends ?token=<value>
# to the registered callback URL; verified timing-safely). While unset, the
# callbacks accept unauthenticated POSTs and production logs a startup warning.
# Activation steps: docs/runbooks/RUNBOOK-mpesa-callback-gate.md.
# MPESA_CALLBACK_TOKEN=

