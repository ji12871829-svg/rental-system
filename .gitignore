node_modules/
.env
# Every env-file variant (.env.production, backend/.env.staging, …) — only
# the placeholder template stays trackable.
.env.*
!.env.example
*.log
.DS_Store
coverage/

# Build artifacts — built by CI/Render, never committed
backend/dist/
frontend/dist/
shared/dist/
# tsc -b incremental cache (regenerated on every typecheck/build)
*.tsbuildinfo
.neon
.env.local
env.txt

# Credential recovery codes at the repo root — secret material, never commit.
# Anchored to root so identically-named files inside source dirs stay trackable.
/recovery-codes.txt

# Stray duplicate clone of this repo (had its own .git); never commit it
rental-system/

# Freebuff client workspace state (logs, project id) — machine-local, not source
.freebuff/

# Regenerable output of scripts/profile-live.mjs
scripts/profile-baseline.after.json

# Local media/scratch output — regenerated by tooling, far too big for git
# (the brag-output-* dirs each embed a .venv-tts Python virtualenv)
brag-output*
olbano-plaza-video-kit/
videos/

# Local tooling: standalone oxlint binary (scripts/run-oxlint.mjs fallback)
.tools/
.ua/

# Generated knowledge graph (graphify) — local tooling state, rebuilt on demand
graphify-out/

# Raw photo drops at the repo root (e.g. "olbano plaza.jpeg") — working
# material for the optimized set in frontend/public/, never source. Anchor
# to root so real images inside subdirectories stay trackable.
/*.jpeg
/*.jpg

# canvas-design renderer scratch — vendored deps for the art scripts (fonts + sources stay tracked-eligible)
design/work/node_modules/
