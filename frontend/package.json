{
  "name": "rpms-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:dark-mode": "node ../scripts/check-dark-mode.mjs",
    "guard:dark-mode-classes": "node ../scripts/check-dark-mode-classes.mjs",
    "test:dark-mode": "npx playwright test dark-mode-screenshot"
  },
  "dependencies": {
    "@clerk/react": "^6.16.1",
    "@rpms/shared": "file:../shared",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.41.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.40",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.7",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
