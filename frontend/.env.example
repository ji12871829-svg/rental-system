# Frontend build-time configuration (Vite exposes only VITE_* variables).
# Everything here is optional — the app runs fully without any of it.

# Clerk hosted sign-in for the staff tab of /login. Unset = password form
# only. Pair with CLERK_SECRET_KEY on the backend and map users per
# docs/RUNBOOK-clerk-setup.md.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_…
# API origin for split deploys (frontend and backend on different domains).
# Leave unset when Express serves frontend/dist itself (same-origin, no CORS).
# For a split deploy set it to the backend's public URL, e.g.:
# VITE_API_URL=https://your-api.onrender.com
