{
  "info": {
    "name": "Rental Management System",
    "description": "Complete API collection for the single-building Rental Management System. Every endpoint has at least one success and one failure example.\n\nAUTH MODEL: the web client uses httpOnly SameSite cookies + a CSRF header (X-CSRF-Token). Postman is not a browser, so this collection uses the API-client flow: run 'Login (token)' first — it calls POST /auth/login/token, and its test script stores the JWT in the `token` collection variable referenced by the Authorization headers. Mutations sent with a Bearer token skip CSRF validation by design (see README). Base URL defaults to localhost:4000; override `baseUrl` for a deployed environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (token) — success (API-client flow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login/token",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@olbano.example\",\n  \"password\": \"ChangeMe123!\"\n}" }
          }
        },
        {
          "name": "Login (cookie) — success (web-app flow)",
          "description": "Sets the httpOnly rms_token + rms_csrf cookies (Postman's cookie jar stores them). Mutations made with cookies (instead of the Bearer token) must carry X-CSRF-Token: {{csrfToken}}.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', json.csrfToken);",
                  "const cookie = pm.cookies.get('rms_csrf');",
                  "if (cookie) pm.collectionVariables.set('csrfToken', cookie);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@olbano.example\",\n  \"password\": \"ChangeMe123!\"\n}" }
          }
        },
        {
          "name": "Logout — success (clears session cookies)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Login — failure (wrong password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@olbano.example\",\n  \"password\": \"WrongPassword1\"\n}" }
          }
        },
        {
          "name": "Me — success",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Me — failure (missing token)",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
