{
  "name": "rms-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "migrate": "node src/config/runMigrations.js",
    "seed": "node src/config/runSeed.js",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "cross-env NODE_PATH=../server/node_modules jest --runInBand",
    "test:unit": "cross-env NODE_PATH=../server/node_modules jest --runInBand --testPathPatterns tests/unit",
    "test:integration": "cross-env NODE_PATH=../server/node_modules jest --runInBand --testPathPatterns tests/integration"
  },
  "jest": {
    "roots": [
      "<rootDir>/../tests"
    ],
    "globalSetup": "<rootDir>/../tests/integration/globalSetup.js",
    "globalTeardown": "<rootDir>/../tests/integration/globalTeardown.js",
    "setupFiles": ["<rootDir>/../tests/integration/env.js"],
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules",
      "../server/node_modules"
    ]
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mime": "^2.6.0",
    "nodemon": "^3.1.0",
    "pg": "^8.23.0",
    "supertest": "^7.0.0"
  }
}
